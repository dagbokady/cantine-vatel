{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev"],
      "port": 5173
    },
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-lc", "cd backend && .venv/bin/uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"],
      "port": 8000
    }
  ]
}
