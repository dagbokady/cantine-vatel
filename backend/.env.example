# true en ligne : documentation cachée, pas d'accès réseau local, secrets obligatoires
PRODUCTION=false
DATABASE_URL=postgresql+psycopg://cantine:cantine@localhost:5432/cantine
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173
# PEM PKCS8 non chiffré, ou toute valeur aléatoire longue (openssl rand -hex 32). PEM généré par :
# python -c "from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PrivateKey; from cryptography.hazmat.primitives import serialization; print(Ed25519PrivateKey.generate().private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()).decode())"
TICKET_SIGNING_KEY=
# Comptoir : true = refuser un ticket hors de son créneau
COMPTOIR_CONTROLE_CRENEAU=true
# Démonstration chargée au démarrage si la base n'a aucun élève (jamais d'effacement d'une école en service).
SEED_DEMO=false
# URL publique du frontend (liens des e-mails). Vide : première adresse de CORS_ORIGINS
FRONTEND_URL=http://localhost:5173
# SMTP pour les e-mails de réinitialisation (vide = lien affiché dans les logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Cantine Vatel <no-reply@cantine-vatel.ci>
SMTP_SSL=false
# Mailjet (SMTP_HOST=in-v3.mailjet.com) : envoi par son API HTTPS, car Render gratuit bloque les ports SMTP.
# SMTP_USER = clé API Mailjet, SMTP_PASSWORD = clé secrète, SMTP_FROM = expéditeur validé dans Mailjet.
